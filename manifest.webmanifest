{
  "name": "PitchTrack Baseball Chart",
  "short_name": "PitchTrack",
  "description": "Offline baseball pitch chart and game tracker",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f5f2e9",
  "theme_color": "#102820",
  "icons": [
